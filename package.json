{
  "name": "sumplog",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:client dev:server",
    "dev:client": "vite",
    "dev:server": "bun --hot server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "bun server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun server/db/migrate.ts",
    "db:seed": "bun server/db/seed.ts",
    "test": "bun test",
    "check": "bun run build && bun test"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "archiver": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.5",
    "lucide-react": "^1.39.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "jszip": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
