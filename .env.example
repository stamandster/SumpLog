# Hono port. The Vite development client uses 5173.
PORT=3000

# SQLite file and uploaded-file directory.
DATABASE_URL=./data/sumplog.db
UPLOAD_DIRECTORY=./data/uploads

# With a password configured, the server defaults to 0.0.0.0 for LAN access.
# Use a unique value of at least 12 characters. Do not commit the real password.
SUMPLOG_PASSWORD=replace-with-a-long-password
HOST=0.0.0.0
